{
  "name": "@harness/agent-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dist/main.js",
    "start:framework-dev": "LANGGRAPH_CLI_NO_ANALYTICS=1 LANGSMITH_TRACING=false LANGSMITH_TRACING_V2=false langgraphjs dev --config langgraph.json --host 127.0.0.1 --port 2024 --n-jobs-per-worker 1 --no-browser --no-reload",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "1.5.5",
    "@types/better-sqlite3": "7.6.13"
  },
  "dependencies": {
    "@harness/agent": "0.0.0",
    "@hono/node-server": "1.19.17",
    "@langchain/core": "1.3.0",
    "@langchain/langgraph-api": "1.5.5",
    "@langchain/langgraph-checkpoint": "1.2.1",
    "@langchain/langgraph-checkpoint-sqlite": "1.1.0",
    "@langchain/langgraph-sdk": "1.12.7",
    "better-sqlite3": "12.10.0",
    "hono": "4.13.14"
  }
}
